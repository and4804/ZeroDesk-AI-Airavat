# ==============================
# AgentFinance AI - Environment Variables
# ==============================

# Groq API (LLM inference - get free key at console.groq.com)
GROQ_API_KEY=gsk_your_key_here

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BUREAU_MOCK_URL=http://localhost:8001

# Bureau Mock
BUREAU_HOST=0.0.0.0
BUREAU_PORT=8001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
FRONTEND_URL=http://localhost:3000

# JWT Secret (generate a random string)
JWT_SECRET=agentfinance-hackathon-secret-key-change-me

# SQLite
DATABASE_PATH=./data/agentfinance.db

# Vision
LIVENESS_THRESHOLD=0.6
AGE_DELTA_THRESHOLD=10
FRAME_CAPTURE_INTERVAL_MS=3000

# Fraud
FRAUD_HIGH_THRESHOLD=60
FRAUD_MEDIUM_THRESHOLD=30
VELOCITY_WINDOW_MINUTES=60
MAX_SESSIONS_PER_DEVICE=3

# GeoIP
GEOIP_API_URL=http://ip-api.com/json

# STT
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
